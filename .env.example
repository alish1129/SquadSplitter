# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
#
# The anon/public key is safe to ship in client code -- it only ever grants
# what your Row Level Security policies in supabase/schema.sql allow.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
